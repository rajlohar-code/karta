# Karta Environment Variables Example
# Copy this file to .env and adjust values for your local environment:
# cp .env.example .env

PROJECT_NAME="Karta"
DEBUG=True
API_V1_STR="/api/v1"

# Database Connection String (PostgreSQL with asyncpg driver)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/karta
# Neon:  postgresql+asyncpg://user:password@ep-xyz.neon.tech/karta?ssl=require
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/karta"

# Secret Key for signed session cookies
SECRET_KEY="karta_insecure_dev_secret_change_in_production"
