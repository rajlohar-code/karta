{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sync Code to PostgreSQL (code2pg)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/code2pg.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "FastAPI: Run Backend Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
